<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title : 'Message Board' %></title>
  <style>
    :root {
      --bg: #f4f4f8;
      --surface: #fff;
      --text: #1a1a22;
      --muted: #5c5c6e;
      --accent: #3d5a80;
      --accent-hover: #2c4666;
      --border: #e0e0e8;
      --danger: #b33a3a;
      --radius: 8px;
      --font: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: var(--font);
      font-size: 16px;
      line-height: 1.45;
      color: var(--text);
      background: var(--bg);
      min-height: 100vh;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; color: var(--accent-hover); }
    .site-header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
    }
    .site-header__inner {
      max-width: 52rem;
      margin: 0 auto;
      padding: 0.75rem 1rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .logo { font-weight: 700; color: var(--text); }
    .logo:hover { text-decoration: none; color: var(--accent); }
    .site-nav {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
      font-size: 0.95rem;
    }
    .site-nav__user { color: var(--muted); font-size: 0.9rem; }
    .site-nav__user strong { color: var(--text); }
    .wrap {
      max-width: 52rem;
      margin: 0 auto;
      padding: 1.25rem 1rem 2rem;
    }
    .page-title { margin: 0 0 0.35rem; font-size: 1.5rem; }
    .page-intro { margin: 0 0 1.25rem; color: var(--muted); font-size: 0.95rem; }
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.1rem;
      margin-bottom: 1rem;
    }
    .panel__head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }
    .panel__title { margin: 0; font-size: 1.05rem; }
    .msg {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.92rem;
    }
    .msg:last-child { border-bottom: none; }
    .msg__meta { font-size: 0.8rem; color: var(--muted); margin-bottom: 0.2rem; }
    .msg__body { margin: 0; white-space: pre-wrap; word-break: break-word; }
    .empty-hint { color: var(--muted); font-size: 0.9rem; margin: 0; }
    .btn {
      font: inherit;
      cursor: pointer;
      border-radius: 6px;
      border: 1px solid var(--border);
      padding: 0.35rem 0.65rem;
      background: var(--surface);
      color: var(--text);
    }
    .btn:hover { border-color: var(--muted); }
    .btn--primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .btn--primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); color: #fff; text-decoration: none; }
    .btn--ghost { background: transparent; }
    .btn--danger { color: var(--danger); border-color: #e8b4b4; }
    .btn--danger:hover { background: #fdf2f2; }
    .btn--small { font-size: 0.85rem; padding: 0.25rem 0.5rem; }
    .toolbar { margin-bottom: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
    .topic-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.65rem 0;
      border-bottom: 1px solid var(--border);
    }
    .topic-row:last-child { border-bottom: none; }
    .topic-row__title { margin: 0; font-size: 1rem; font-weight: 600; }
    .site-footer {
      max-width: 52rem;
      margin: 2rem auto 0;
      padding: 1rem;
      font-size: 0.85rem;
      color: var(--muted);
      text-align: center;
    }
  </style>
</head>
<body>
  <%- include('../partials/nav', { user: typeof user !== 'undefined' ? user : null }) %>
  <main class="wrap">
